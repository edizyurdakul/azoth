{
	"name": "azoth",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"bun": ">=1.3.1"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "bun run --filter '@azoth/*' typecheck",
		"test": "bun run --filter '@azoth/*' test"
	},
	"devDependencies": {
		"@azoth/cli": "workspace:*",
		"@biomejs/biome": "^2.5.6",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/bun": "latest",
		"lefthook": "^2.1.10"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
